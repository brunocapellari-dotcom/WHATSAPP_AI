LOCAL_TENANT_ID=freight-prod
LOCAL_PROVIDER_ID=wppconnect
WPP_SESSION_NAME=freight-prod

POSTGRES_ADMIN_PASSWORD=example-admin-password
DB_INGEST_PASSWORD=example-ingest-password
DB_WORKER_PASSWORD=example-worker-password

WHATSAPP_RAW_ENCRYPTION_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BRIDGE_OUTBOX_KEY_B64=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
PROVIDER_HMAC_SECRET=example-provider-hmac-secret
WPP_SECRET_KEY=example-wpp-secret-key-with-at-least-thirty-two-characters

LOCAL_AGROLOG_HOST=host.docker.internal
LOCAL_AGROLOG_URL=http://host.docker.internal:8000/v1/freight/events
AGROLOG_SHARED_SECRET=example-agrolog-shared-secret
ENABLE_LOCAL_AGROLOG_DELIVERY=0

# Optional host loopback ports (defaults 8080 / 21465)
# LOCAL_INGRESS_PORT=8080
# LOCAL_WPP_PORT=21465
