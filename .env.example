# Zero-cost is the canonical mode. It blocks known billable providers/endpoints.
NODE_ENV=development
ZERO_COST_MODE=true
HOST=0.0.0.0
PORT=3000

# Docker Compose secrets/runtime. Generate unique values before first real use.
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgres://whatsapp_ai:local_change_me@postgres:5432/whatsapp_ai
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

APP_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
PII_HMAC_KEY=replace-with-at-least-32-random-bytes
INTERNAL_API_KEY=replace-with-strong-internal-api-key
METRICS_TOKEN=replace-with-dedicated-metrics-token

# Meta Cloud is OPTIONAL and intentionally disabled in ZERO_COST_MODE.
# Setting sending credentials while ZERO_COST_MODE=true is rejected at startup.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v26.0
META_GROUPS_ENABLED=false

# Zero-cost existing-group provider.
WPP_BASE_URL=http://wppconnect:21465
WPP_API_TOKEN=replace-with-strong-wpp-secret
WPP_COLLECTOR_ID=wpp-freight-default
WPP_SESSION=default
WPP_RECONCILE_INTERVAL_MS=15000
# Optional only when using a trusted signing proxy for direct WPP webhooks.
WPP_WEBHOOK_SECRET=

# Local AI only in ZERO_COST_MODE.
LOCAL_AI_BASE_URL=http://ollama:11434
LOCAL_AI_MODEL=qwen3-vl:4b-instruct
# In production, fill with: npm run model:digest
LOCAL_AI_MODEL_DIGEST=
LOCAL_AI_TIMEOUT_MS=120000
WHISPER_BASE_URL=http://whisper:8080
WHISPER_MODEL=small
WHISPER_TIMEOUT_MS=120000
PDF_MAX_PAGES=12

# AgroLog HTTP delivery is optional. The zero-cost local export path is configured separately.
AGROLOG_GATEWAY_URL=
AGROLOG_GATEWAY_TOKEN=
AGROLOG_EXPORT_DIR=/data/agrolog-export

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ATTACHMENT_MAX_BYTES=26214400
WEBHOOK_MAX_BYTES=4194304
